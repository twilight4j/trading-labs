# 복사: cp .env.example .env
# KRX 정보데이터시스템 (https://data.krx.co.kr) 회원 계정
KRX_ID=
KRX_PW=
# OpenDART (https://opendart.fss.or.kr) API 키
DART_API_KEY=
# labs API(labs-api serve) 토큰 — trading-engine·trading-gateway .env 의 UI_API_TOKEN 과 같은 값(16자 이상). 없으면 API 가 모든 요청을
# 거부합니다. 화면에는 넣지 않습니다 — 게이트웨이가 구글 로그인한 요청에만 붙여 넘깁니다.
UI_API_TOKEN=
